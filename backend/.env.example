# CitySense AI Backend Environment Configuration

# Server Port
PORT=5000

# Google Gemini API Key for Grounded Conversational Assistant (RAG)
# If left blank, CitySense automatically falls back to its built-in Grounded Decision Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Default Exploration Coordinates & City
DEFAULT_CITY=Pune
DEFAULT_LAT=18.5204
DEFAULT_LNG=73.8567
