# CitySense AI Environment Configuration

# Server Port
PORT=5000

# Optional: Google Gemini API Key for Generative RAG Assistant
# If left blank, CitySense automatically runs on its built-in Grounded Decision Engine with 100% functionality
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Default Exploration City
DEFAULT_CITY=Pune
DEFAULT_LAT=18.5204
DEFAULT_LNG=73.8567
